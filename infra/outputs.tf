output "url" {
  value = local.custom_domain ? "https://${var.domain_name}" : "https://${aws_cloudfront_distribution.main.domain_name}"
}

output "cloudfront_domain" {
  value = aws_cloudfront_distribution.main.domain_name
}

# Settings for this machine. CI gets the same names from the repository's
# Actions variables (see the README), so none of this is committed.
resource "local_file" "deploy_env" {
  filename        = "${path.module}/../.github/deploy.env"
  file_permission = "0644"
  content         = <<-EOT
    # Generated by Terraform (infra/outputs.tf). Do not edit or commit.
    AWS_REGION=${data.aws_region.current.region}
    DEPLOY_ROLE_ARN=${aws_iam_role.github_deploy.arn}
    SITE_BUCKET=${aws_s3_bucket.site.id}
    DISTRIBUTION_ID=${aws_cloudfront_distribution.main.id}
    SITE_URL=${local.custom_domain ? "https://${var.domain_name}" : "https://${aws_cloudfront_distribution.main.domain_name}"}
  EOT
}
