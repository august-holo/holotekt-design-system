{
  "name": "holotekt-design-system",
  "version": "0.8.0",
  "description": "Design tokens, React components and documentation for the holotekt design system.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": "github:august-holo/holotekt-design-system",
  "homepage": "https://designsystem.holotekt.com",
  "files": [
    "dist",
    "tokens",
    "src/components",
    "scripts/build-tokens.mjs",
    "scripts/build-components.mjs",
    "scripts/lib",
    "tsconfig.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./text-styles.css": "./dist/text-styles.css",
    "./utilities.css": "./dist/utilities.css",
    "./components.css": "./dist/components.css",
    "./tokens.json": "./dist/tokens.json",
    "./components.json": "./dist/components.json"
  },
  "scripts": {
    "tokens:check": "node scripts/check-tokens.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:diff": "node scripts/diff-tokens.mjs",
    "components:build": "node scripts/build-components.mjs",
    "check:scenarios": "node scripts/check-scenarios.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p site && tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "node scripts/copy-fonts.mjs && storybook build -o site/public/storybook",
    "storybook:test": "vitest run",
    "build:site": "node scripts/copy-fonts.mjs && next build site && node scripts/place-twins.mjs && node scripts/check-links.mjs",
    "check": "npm run tokens:check && npm run tokens:build && npm run components:build && npm run check:scenarios && npm run lint && npm run typecheck && npm run storybook:build && npm run storybook:test && npm run build:site",
    "dev": "node scripts/dev.mjs",
    "release": "node scripts/release.mjs",
    "deploy": "scripts/deploy.sh",
    "prepare": "node scripts/build-tokens.mjs && node scripts/build-components.mjs"
  },
  "devDependencies": {
    "@fontsource/arvo": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/diphylleia": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/addon-mcp": "^10.6.9",
    "@storybook/addon-vitest": "^10.6.9",
    "@storybook/react-vite": "^10.6.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.2",
    "@vitest/browser-playwright": "^5.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "gray-matter": "^4.0.3",
    "next": "16.4.6",
    "playwright": "^1.65.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.9",
    "storybook-addon-pseudo-states": "^10.6.9",
    "style-dictionary": "^5.8.0",
    "typescript": "^5",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
